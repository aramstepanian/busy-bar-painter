# Copy to .env and fill in what you need. .env is gitignored.
# Values already set in the environment win over this file.

# usb talks to the bar on the USB cable. cloud talks to api.busy.app.
BUSY_TRANSPORT=usb

# Bar origin on the USB cable, such as http://10.0.4.20
BUSY_HOST=http://10.0.4.20

# Optional HTTP API PIN. Leave empty on USB. Sent as the X-API-Token header.
BUSY_PIN=

# Cloud API token. Required when BUSY_TRANSPORT=cloud.
BUSY_BAR_TOKEN=

# Place for sunrise, sunset, weather, and the clock. Defaults are Santa Clara, CA.
BUSY_LAT=37.3541
BUSY_LON=-121.9552
BUSY_TZ=America/Los_Angeles
BUSY_LABEL=Santa Clara, CA

# Weather and the ISS use a proxy when the Mac has no direct internet.
# BUSY_PROXY wins, then HTTPS_PROXY, then HTTP_PROXY.
# Leave all three empty on a Mac to read the PAC URL from `scutil --proxy`.
# BUSY_PROXY=http://proxy.example:8080
BUSY_PROXY=
HTTPS_PROXY=
HTTP_PROXY=
# The bar always connects directly. These names are never sent to the proxy.
NO_PROXY=10.0.4.20,localhost,127.0.0.1

# Corporate root CA, when the proxy intercepts HTTPS.
# BUSY_CA_BUNDLE=/path/to/corporate-root.pem
BUSY_CA_BUNDLE=

# Last resort. Skips TLS verification for weather and the ISS only. Not recommended.
BUSY_INSECURE_TLS=
